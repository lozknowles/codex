# Non-secret defaults for the local Termux build. Copy this file to
# .env.termux to override values locally. GitHub Actions repository variables
# with matching names may also override these defaults.
CODEX_TERMUX_TARGET=aarch64-linux-android
CODEX_TERMUX_ANDROID_API=29
CODEX_TERMUX_ANDROID_CLANG_TARGET=aarch64-linux-android29
CODEX_TERMUX_ANDROID_NDK_VERSION=28.2.13676358
CODEX_TERMUX_RUST_VERSION=1.95.0
CODEX_TERMUX_BUILD_PROFILE=release
CODEX_TERMUX_ARTIFACT_RETENTION_DAYS=14
CODEX_TERMUX_INSTALL_DIR_NAME=codex-termux-local
CODEX_TERMUX_SOURCE_REPOSITORY=lozknowles/codex
CODEX_TERMUX_NPM_PACKAGE=@mmmbuto/codex-cli-termux

# The V8 archive is an immutable, checksum-verified build input. Override this
# when the artifacts are mirrored into lozknowles/codex releases.
CODEX_TERMUX_V8_REPOSITORY=DioNanos/codex-termux
