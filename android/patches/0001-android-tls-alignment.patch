diff --git a/codex-rs/cli/src/android_tls_alignment.rs b/codex-rs/cli/src/android_tls_alignment.rs
new file mode 100644
index 000000000..3301f3c6a
--- /dev/null
+++ b/codex-rs/cli/src/android_tls_alignment.rs
@@ -0,0 +1,9 @@
+//! Android requires executable TLS segments to be aligned to 64 bytes.
+
+#[repr(align(64))]
+#[allow(dead_code)]
+struct AndroidTlsAlignment([u8; 64]);
+
+#[used]
+#[unsafe(link_section = ".tdata")]
+static ANDROID_TLS_ALIGNMENT: AndroidTlsAlignment = AndroidTlsAlignment([0; 64]);
